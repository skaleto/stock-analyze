[Unit]
Description=Stock Analyze daily simulation run (Codex agent)
After=network-online.target
Wants=network-online.target
OnFailure=stock-analyze-pipeline-failure@%n.service
OnSuccess=stock-analyze-daily-finalize.service

[Service]
Type=oneshot
WorkingDirectory=/opt/stock-analyze/app
Environment=TZ=Asia/Shanghai
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
ExecStart=/opt/stock-analyze/venv/bin/python -m stock_analyze.cli --agent codex --logs-dir /opt/stock-analyze/logs run-daily --offline
StandardOutput=append:/opt/stock-analyze/logs/codex-daily.log
StandardError=append:/opt/stock-analyze/logs/codex-daily.err
