[Unit]
Description=Stock Analyze monthly local-training bundle preparation
After=network-online.target
Wants=network-online.target
OnFailure=stock-analyze-pipeline-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/stock-analyze/app
Environment=TZ=Asia/Shanghai
MemoryHigh=900M
MemoryMax=1250M
Nice=10
ExecStart=/usr/bin/flock --nonblock /run/stock-analyze-model-training.lock /opt/stock-analyze/app/scripts/prepare-model-training-bundles.sh
StandardOutput=append:/opt/stock-analyze/logs/model-training.log
StandardError=append:/opt/stock-analyze/logs/model-training.err
