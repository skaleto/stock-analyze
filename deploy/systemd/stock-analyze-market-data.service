[Unit]
Description=Stock Analyze shared market-data fetch (writes data/shared/cache/ once per weekday)
After=network-online.target
Wants=network-online.target
# Shared-layer failures (e.g. Tushare EOD data not yet published -> empty spot)
# must NOT be silent: route them to the same failure notifier the per-agent
# services use, so a failed fetch lands in PIPELINE_FAILURES.log + a DM alert.
OnFailure=stock-analyze-pipeline-failure@%n.service

[Service]
Type=oneshot
WorkingDirectory=/opt/stock-analyze/app
Environment=TZ=Asia/Shanghai
Environment=MALLOC_ARENA_MAX=2
Environment=OMP_NUM_THREADS=1
Environment=OPENBLAS_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=NUMEXPR_NUM_THREADS=1
# Tushare Pro token is injected via this file (chmod 600, root-owned).
# Missing file -> service fails to start with clear "EnvironmentFile not found".
# See docs/tushare-token-setup.md for provisioning.
EnvironmentFile=/etc/stock-analyze/secrets.env
Environment=IFIND_PYTHON=/opt/stock-analyze/vendor/ifind/venv/bin/python
Environment=IFIND_GATEWAY=/opt/stock-analyze/app/scripts/ifind_sdk_gateway.py
Environment=IFIND_SDK_LIB_DIRS=/opt/stock-analyze/vendor/ifind/1.10.22.44.001/bin64:/opt/stock-analyze/vendor/ifind/1.10.22.44.001/compat/root/lib/x86_64-linux-gnu
Environment=IFIND_USER_FILE=/etc/stock-analyze/secrets/ifind_username
Environment=IFIND_PASSWORD_FILE=/etc/stock-analyze/secrets/ifind_password
ExecStart=/opt/stock-analyze/venv/bin/python -m stock_analyze.cli --logs-dir /opt/stock-analyze/logs prepare-market-data
# QDII strategies and the isolated model portfolio are offline downstream.
# Warm every catalog instrument before building the immutable research snapshot.
ExecStart=/opt/stock-analyze/venv/bin/python -m stock_analyze.cli prepare-qdii-market-data
# Secondary-source failures do not block research; the weekly audited run alerts.
ExecStart=-/opt/stock-analyze/venv/bin/python -m stock_analyze.cli intelligence-source-audit --repo-root /opt/stock-analyze/app --datasets market --supplement
# Keep decision-relevant announcement gaps small without spending the
# full-market trial quota every trading day.
ExecStart=-/opt/stock-analyze/venv/bin/python -m stock_analyze.cli intelligence-source-audit --repo-root /opt/stock-analyze/app --datasets announcement --announcement-scope operational --supplement
# Source collection is the only research stage that receives credentials.
ExecStart=/opt/stock-analyze/venv/bin/python -m stock_analyze.cli --market a_share --agent codex prepare-research-data --force
ExecStart=/opt/stock-analyze/venv/bin/python -m stock_analyze.cli --market cn_qdii_etf --agent codex prepare-research-data --force
# Feature/event/prediction research consumes the immutable snapshot without secrets;
# its successful completion starts the existing A-share decision services.
ExecStartPost=/bin/systemctl start --no-block stock-analyze-research.service
StandardOutput=append:/opt/stock-analyze/logs/market-data.log
StandardError=append:/opt/stock-analyze/logs/market-data.err
